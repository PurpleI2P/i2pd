#!/sbin/openrc-run

pidfile="/run/i2pd/i2pd.pid"
logfile="/var/log/i2pd/i2pd.log"
mainconf="/etc/i2pd/i2pd.conf"
tunconf="/etc/i2pd/tunnels.conf"
tundir="/etc/i2pd/tunnels.conf.d"

command="/usr/bin/i2pd"
command_args="--service --log=file --logfile=$logfile --conf=$mainconf --tunconf=$tunconf --tunnelsdir=$tundir $DAEMON_OPTS"
command_args_background="--daemon --pidfile=${pidfile}"
command_user="i2pd:adm"
description="C++ daemon for accessing the I2P network"
required_dirs="/var/lib/i2pd"
required_files="$mainconf"

depend() {
  need mountall
  use net
  after bootmisc
}

start_pre() {
  if [ -r /etc/default/i2pd ]; then
    . /etc/default/i2pd
  fi

  if [ "x$I2PD_ENABLED" != "xyes" ]; then
    ewarn "i2pd disabled in /etc/default/i2pd"
    exit 1
  fi

  checkpath -d -m 0755 -o ${command_user} /var/log/i2pd
  checkpath -d -m 0755 -o ${command_user} /run/i2pd
  checkpath -f -o ${command_user} $logfile
  checkpath -f -o ${command_user} $pidfile
}
