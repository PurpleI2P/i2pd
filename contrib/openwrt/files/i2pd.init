#!/bin/sh /etc/rc.common

USE_PROCD=1

# PROCD_DEBUG=1

## Tune it
START=90
STOP=10

USER="i2pd"
GROUP="i2pd"
PIDFILE=/var/run/i2pd.pid
## RAM tmpfs or external storage (usb or network mounted device), don't use internal flash!
DATADIR=/var/lib/i2pd

start_service()
{
  if [ ! -d $DATADIR ]
  then
    mkdir -p -m0750 $DATADIR
    chown $USER:$GROUP $DATADIR
  fi

  procd_open_instance
  procd_set_param command /usr/bin/i2pd  --datadir=$DATADIR  --conf=/etc/i2pd/i2pd.conf
## For debugging add at least 512 MB on external storage, 
## adjust /proc/sys/kernel/core_pattern, enable unlimited size coredump 
#  echo "/tmp/coredumps/core.%e.%p.%s.%t" > /proc/sys/kernel/core_pattern
#  procd_set_param limits core="unlimited unlimited"
  procd_set_param limits nofile="4096 4096"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param user $USER
  procd_set_param env HOME=$DATADIR
  procd_set_param pidfile $PIDFILE
  procd_close_instance
}

